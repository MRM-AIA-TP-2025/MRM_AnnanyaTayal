  #include <iostream>
#include <vector>
using namespace std;

//add code below this line

void GetOddsEvens(const string like, const vector<int> numbers)
{ 
  int num;
  if (like=="true")
  {
    for (int num: numbers)
    {
      if (num%2==0)
      cout << num << endl;
    }
  }
  else if (like == "false")
  {
    for (int num: numbers)
    {
      if (num%2!=0)
      cout << num << endl;
    }
  }
  else 
  cout << "Command was successfully excuted" << endl;
}

//add code above this line

int main(int argc, char** argv) {
  string x = argv[1];
  vector<int> y;
  for (int i = 2; i < argc; i++) {
    y.push_back(stoi(argv[i]));
  }
  GetOddsEvens(x, y);
}

